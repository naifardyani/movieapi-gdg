#Nanti ganti ini dengan .env real

PORT=8000

# Supabase → Connect → "Session pooler" (IPv4, port 5432).
# NOT the "Direct connection" string: that host is IPv6-only and Render has no
# outbound IPv6, so it times out. NOT the transaction pooler on :6543 either:
# that mode cannot run prepared statements and breaks `prisma migrate deploy`.
#
# Percent-encode special characters in the password: ? -> %3F, @ -> %40,
# # -> %23, & -> %26, / -> %2F.
# Keep uselibpqcompat=true: pg-connection-string treats sslmode=require as
# verify-full, which fails against the pooler's certificate chain.
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require&uselibpqcompat=true"

# Optional: Prisma/pg pool size. Supavisor caps connections per role.
# DB_POOL_MAX=5

# Local Postgres, used only by `npm test`. The test runner drops and recreates
# this database on every run, so it must never point at Supabase.
TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/watchlist_test"
JWT_SECRET="#IndonesiaSADAR-WeDeserveBetterLife!" #JWTKey
GEMINI_API_KEY="apikeygemini"